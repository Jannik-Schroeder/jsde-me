# Public base URL of the site, used for metadata, OpenGraph and the RSS feed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI key for the terminal chat agent. Without it /api/chat is disabled.
OPENAI_API_KEY=
# Model id for the chat agent. Defaults to gpt-5.6-luna when empty.
OPENAI_MODEL=
# Global cap on chat messages per day. Defaults to 500 when empty.
CHAT_DAILY_CAP=
# Endpoint serving resting heart rate, steps and sleep for the statusline.
FITNESS_STATUS_URL=
# Bearer token for FITNESS_STATUS_URL.
FITNESS_STATUS_TOKEN=
# GitHub personal access token used to count today's commits.
GITHUB_TOKEN=
# GitHub username whose commits are counted.
GITHUB_USER=
# Base URL of the Forgejo instance used to count today's commits.
FORGEJO_URL=
# Forgejo API token for FORGEJO_URL.
FORGEJO_TOKEN=
# Forgejo username whose commits are counted.
FORGEJO_USER=
# WakaTime API key used for today's coding time.
WAKATIME_API_KEY=
